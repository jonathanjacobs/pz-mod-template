# Shell scripts must keep LF endings to run under bash on CI and in Git Bash.
*.sh text eol=lf

# Development-only paths left out of `git archive` exports used to build the
# Workshop authoring directory (see docs/STEAM_WORKSHOP.md).
.github/ export-ignore
tools/ export-ignore
scripts/ export-ignore
source/ export-ignore
Logs/ export-ignore
decompiled/ export-ignore
research-source/ export-ignore
.gitattributes export-ignore
.gitignore export-ignore
AGENTS.md export-ignore
